{
  "name": "noah-icu-lab",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Accessible adult cardiopulmonary and bedside ICU teaching simulator with synthetic physiology.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:pulmonary && npm run test:bedside && npm run test:curriculum",
    "test:pulmonary": "node --import tsx tests/pulmonary.test.ts",
    "test:bedside": "node --import tsx tests/bedside.test.ts",
    "test:curriculum": "node --import tsx ../../shared/noah-resuscitation/curriculum.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4"
  }
}
