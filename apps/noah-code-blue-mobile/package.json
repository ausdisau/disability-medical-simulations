{
  "name": "noah-code-blue-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --import tsx tests/pulmonary.test.ts",
    "test:session": "node --import tsx tests/session.test.ts",
    "verify:engine": "node scripts/check-engine.mjs",
    "test": "npm run verify:engine && npm run test:engine && npm run test:session && npm run test:curriculum && npm run test:learning && npm run test:ui",
    "export:web": "expo export --platform web --output-dir dist-web",
    "test:curriculum": "node --import tsx ../../shared/noah-resuscitation/curriculum.test.ts",
    "test:learning": "node --import tsx tests/learning.test.ts",
    "test:ui": "jest --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "expo": "58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "test-renderer": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
