{
  "name": "noah-code-blue-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --import tsx tests/pulmonary.test.ts",
    "test:session": "node --import tsx tests/session.test.ts",
    "verify:engine": "node scripts/check-engine.mjs",
    "test": "npm run verify:engine && npm run test:engine && npm run test:session",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "expo": "58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "0.21.4",
    "react-native-safe-area-context": "5.10.1",
    "@expo/metro-runtime": "58.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  }
}
