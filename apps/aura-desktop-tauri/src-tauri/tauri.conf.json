{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURA Project Hope",
  "version": "0.1.0",
  "identifier": "au.org.ausdis.projecthope.aura",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../anzcor-react-web -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --prefix ../anzcor-react-web",
    "frontendDist": "../../anzcor-react-web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-src 'self'; object-src 'none'; base-uri 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "AURA · Project Hope (synthetic simulation)",
        "width": 1360,
        "height": 900,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
