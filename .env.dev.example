# Development environment variables (DO NOT COMMIT secrets)
# Copy this file to .env.dev locally and populate values.

# Optional third-party client API. Only VITE_-prefixed values are exposed to the browser.
VITE_THIRD_PARTY_API_KEY=

# Server-only Project Hope persistence. Never expose DATABASE_URL to client code.
DATABASE_URL=
ENABLE_SIM_PERSISTENCE=false
